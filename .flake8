[flake8]
# Require block comments to begin with "# ", as enforced by E265.
extend-select = E265
# Tell pycodestyle to allow '#' followed by '|' as a valid token
block-comment-indexes = |
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv
per-file-ignores =
    __init__.py: F401