# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Python
[*.{py,pyi,py.in,pyi.in}]
indent_size = 4
max_line_length = 88

# Markdown
[*.{md,qmd,Rmd,markdown}]
indent_size = 2
max_line_length = 88
